{
  "manifest_version": 3,
  "name": "Volume Master Pro",
  "version": "3.0.0",
  "icons" : {
    "16": "icon16.png",
    "48": "icon48.png"
  },
  "description": "Boost tab volume cleanly using tabCapture on Chrome and Brave while preserving native browser mute operations.",
  "permissions": [
    "activeTab", 
    "tabCapture", 
    "offscreen", 
    "storage", 
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Volume Master Pro"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}