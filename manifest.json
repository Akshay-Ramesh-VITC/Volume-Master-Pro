{
  "manifest_version": 3,
  "name": "Volume Master Pro",
  "version": "2.1.1",
  "icons" : {
    "16": "icon16.png",
    "48": "icon48.png"
  },
  "description": "Boost tab volume up to 600% and control audio per tab.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Volume Master Pro"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}